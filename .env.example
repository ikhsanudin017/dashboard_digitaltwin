# Example environment variables (do NOT commit real secrets)
# Copy to .env and fill real values on each environment

# Azure Function
AZURE_FUNCTION_URL=https://func-digitaltwin-2026.azurewebsites.net/api/GetTelemetryData
AZURE_FUNCTION_KEY=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=digitaltwin
INFLUX_BUCKET=sensor_data

# Local API (Raspberry Pi)
LOCAL_API_URL=http://localhost:5001

# Frontend / Vite envs
VITE_API_BASE_URL=https://your-function.azurewebsites.net/api
VITE_AZURE_FUNCTION_WRITE_KEY=
VITE_MQTT_BROKER_URL=
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Other
# Add any other service tokens here as needed
