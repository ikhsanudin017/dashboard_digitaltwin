# Azure Storage Configuration for ML
# Copy this file to .env and fill in your values

# Get this from: az storage account show-connection-string --name YOUR_STORAGE_ACCOUNT
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY

# Table name where sensor data is stored
AZURE_TABLE_NAME=SensorTelemetry

# Comma-separated dashboard origins allowed to call the development API.
# Set this to the deployed frontend URL in Azure; never use `*` in production.
ML_CORS_ORIGINS=http://localhost:5173
