[Unit]
Description=Digital Twin Local API Server
After=network.target

[Service]
Type=simple
User=digitaltwin
WorkingDirectory=/mnt/storage
Environment="PATH=/mnt/storage/venv_new/bin"
ExecStart=/mnt/storage/venv_new/bin/python3 /mnt/storage/local_api.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/mnt/storage/local_api.log
StandardError=append:/mnt/storage/local_api.log

[Install]
WantedBy=multi-user.target
