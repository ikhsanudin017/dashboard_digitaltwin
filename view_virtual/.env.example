# Twinuvo AI dashboard configuration
# Every VITE_* value is visible in the browser bundle. Never place a private
# connection string, device key, MQTT password, or unrestricted API key here.

# Read-only/backend endpoints
VITE_AZURE_FUNCTION_URL=https://your-read-api.example/api
VITE_ML_API_URL=http://localhost:5000/api
VITE_CAMERA_STREAM_URL=http://localhost:5000

# Browser-visible map tokens. Keep empty unless required and restrict them by
# allowed origin, API, and quota at the provider.
VITE_CESIUM_ION_TOKEN=
VITE_CESIUM_BASEMAP_ASSET_ID=2275207
VITE_CESIUM_MODEL_ANCHOR_HEIGHT=225.7319374907
VITE_CESIUM_BUILDING_HEIGHT_FINE_TUNE=0.85
VITE_CESIUM_LOD1_ASSET_ID=5139696
VITE_CESIUM_LOD2_ASSET_ID=5139697
VITE_CESIUM_LOD3_ASSET_ID=5139698
VITE_CESIUM_LOD4_ASSET_ID=5139699
VITE_GOOGLE_MAPS_API_KEY=

# Firebase web application configuration (browser-visible identifiers)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Authentication behavior
VITE_AUTH_DEFAULT_DOMAIN=
VITE_ADMIN_EMAILS=
VITE_ADMIN_SESSION_TTL_MINUTES=30

# Development-only local admin fallback. This mechanism is not safe for a
# production build because values are visible to browser users.
VITE_LOCAL_ADMIN_EMAIL=
VITE_LOCAL_ADMIN_PASSWORD=
VITE_LOCAL_ADMIN_NAME=Twinuvo AI Admin

# Legacy write-key support. Keep empty. A production dashboard must use an
# authenticated backend/BFF instead of embedding a function key.
VITE_AZURE_FUNCTION_WRITE_KEY=

# Competition recording mode. Set false only when verified device telemetry,
# camera, and cloud paths are available end to end.
VITE_DEMO_MODE=true
