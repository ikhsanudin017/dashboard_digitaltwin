{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/.pio/libdeps/**",
                "${workspaceFolder}/.platformio/**",
                "~/.platformio/packages/**"
            ],
            "defines": [
                "PLATFORMIO=60115",
                "ARDUINO_ARCH_ESP32",
                "ESP32"
            ],
            "macFrameworkPath": [
                "/System/Library/Frameworks",
                "/Library/Frameworks"
            ],
            "compilerPath": "~/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
